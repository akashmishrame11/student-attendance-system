# Server
NODE_ENV=development
PORT=5000

# MongoDB (local or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/college_erp

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# File uploads
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=10
# Storage driver: "local" (default). Add an S3/Cloudinary driver in src/services/storage.js for production.
STORAGE_DRIVER=local

# ---------------------------------------------------------------- Email
# MAIL_TRANSPORT: smtp | console (prints emails in the API log) | none
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + an App Password
MAIL_TRANSPORT=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Attendify <no-reply@your-college.edu>

# ------------------------------------------------- Cloud file storage (S3)
# Set STORAGE_DRIVER=s3 (above) to store uploads in any S3-compatible bucket:
# AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, Backblaze B2.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public base URL for files, e.g. https://<bucket>.s3.<region>.amazonaws.com or your R2/CDN domain
S3_PUBLIC_URL=
