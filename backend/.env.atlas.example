# Ready-made settings for the shared MongoDB Atlas database.
# 1. Copy this file to backend/.env
# 2. Replace <password> below with the Atlas password (ask the project owner; never commit it)
# 3. Replace JWT_SECRET with a long random string:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The data is already loaded in Atlas, so do NOT run "npm run seed" (it wipes the database).

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas (shared)
MONGO_URI=mongodb+srv://mayankm738again1_db_user:<password>@cluster0.rzsmx8g.mongodb.net/college_erp?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# File uploads
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=10
STORAGE_DRIVER=local

# Email: smtp | console | none (see .env.example)
MAIL_TRANSPORT=console
