NODE_ENV=production
PORT=5000
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/college_erp?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=1d
CLIENT_URL=https://your-frontend-domain.com
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=10
STORAGE_DRIVER=local
# Email (recommended in production)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Attendify <no-reply@your-college.edu>
# Cloud storage (recommended on hosts with ephemeral disks): set STORAGE_DRIVER=s3 above
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=
